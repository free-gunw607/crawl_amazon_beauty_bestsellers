[Unit]
Description=MR snapshot publish at local midnight: US (crawl handled by legacy lane)

[Service]
Type=oneshot
WorkingDirectory=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers
Environment=PYTHONPATH=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/src
ExecStart=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/.venv/bin/python -m crawl_amazon_beauty_bestsellers.cli publish-mr --region us
TimeoutStartSec=1800
