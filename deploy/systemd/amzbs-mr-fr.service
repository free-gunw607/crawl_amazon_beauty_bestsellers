[Unit]
Description=MR detail pass + snapshot at local midnight: fr

[Service]
Type=oneshot
WorkingDirectory=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers
Environment=AMZBS_MARKETPLACE=fr
Environment=PYTHONPATH=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/src
ExecStart=%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/.venv/bin/python %h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/scripts/run_job.py
ExecStartPost=-%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/.venv/bin/python -m crawl_amazon_beauty_bestsellers.cli publish-mr --region fr
TimeoutStartSec=10800
ExecStartPost=-%h/agent-coding/agent-projects/A4-worker-repos/crawl_amazon_beauty_bestsellers/.venv/bin/python -m crawl_amazon_beauty_bestsellers.cli root-cycle --region fr
